local function getHairIds()
    local character = LocalPlayer.Character
    if not character then return {} end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return {} end

    local desc = humanoid:GetAppliedDescription()
    local hairIds = {}

    if desc.HairAccessory and desc.HairAccessory ~= "" then
        for id in string.gmatch(desc.HairAccessory, "%d+") do
            table.insert(hairIds, tonumber(id))
        end
    end

    if desc.HatAccessory and desc.HatAccessory ~= "" then
        for id in string.gmatch(desc.HatAccessory, "%d+") do
            table.insert(hairIds, tonumber(id))
        end
    end

    return hairIds
end

